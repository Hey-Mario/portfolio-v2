# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# EmailJS — used server-side only by the contact form Server Action.
# Dashboard → Account → Security: enable "Allow EmailJS API for non-browser applications".
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
